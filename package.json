{
  "name": "trading-journal",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "run-p dev:*",
    "dev:client": "vite",
    "dev:server": "tsx watch --env-file=.env src/server/index.ts",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production tsx --env-file=.env src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:backup": "tsx src/server/backup.ts",
    "seed": "tsx src/server/seed.ts",
    "seed:reset": "tsx src/server/seed.ts --reset"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wafendy/trading-journal.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wafendy/trading-journal/issues"
  },
  "homepage": "https://github.com/wafendy/trading-journal#readme",
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "@tanstack/react-query": "^5.101.4",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
