# Copy to .env (gitignored) before running `npm run dev` / `npm start`.
# The server loads this file via --env-file=.env and will fail to start if the
# file is missing. Individual variables below are optional — see notes.

# Finnhub API key for earnings-date auto-fill (free at https://finnhub.io).
# Optional: without it the earnings field simply stays manual.
FINNHUB_API_KEY=

# SQLite database file path. Optional — defaults to ./trading.db
DB_PATH=./trading.db

# Ticker link templates for the client. All optional — each configured template becomes
# an outbound link in the trade-details modal (T1MO, TradingView, Yahoo Finance, in that
# order). If all unset, no links are shown.
# ${TICKER} is replaced with the (uppercased) ticker symbol. Must be VITE_-prefixed
# so Vite exposes it to the browser. NOTE: escape the $ as \${TICKER} — Vite runs
# dotenv-expand, which would otherwise treat ${TICKER} as an (empty) shell variable.
VITE_T1MO_URL_TEMPLATE="https://smart.t1mo.app/#/chart/{{TICKER}}"
VITE_TRADING_VIEW_URL_TEMPLATE="https://www.tradingview.com/chart/?symbol={{TICKER}}"
VITE_YAHOO_FINANCE_URL_TEMPLATE="https://finance.yahoo.com/quote/{{TICKER}}"

# Enable per-row "Edit" corrections in Trading History. Optional — OFF unless set to
# exactly "true". This is a deliberate data-fix affordance, not everyday UI: set it,
# restart, fix the mistake, then unset it again. (Client-side gate only — the PATCH
# API accepts these fields regardless; fine for a local single-user journal.)
VITE_ALLOW_HISTORY_EDIT=false

# Minutes to cache live prices in the Active Positions tab before hitting the API
# again on refresh. Optional — defaults to 15.
VITE_PRICE_CACHE_MINUTES=15

# Directory for per-trade chart screenshots (stored as <tradeId>.webp).
# Optional — defaults to ./screenshots. Not required to run the app.
SCREENSHOTS_DIR=./screenshots

# HTTP port for the server. Optional — defaults to 3000
PORT=4568
